<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111214">

    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <app.pane.tablet.CursorOverlay
        android:id="@+id/cursor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <View
        android:id="@+id/touchLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:textColor="#F2F0EC"
        android:textSize="16sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/connectPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111214"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pane"
                android:textColor="#F2F0EC"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Show this tablet as a second Mac display."
                android:textColor="#B7B3AC"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Waiting for the USB cable…"
                android:textColor="#F2F0EC"
                android:textSize="15sp" />

            <Button
                android:id="@+id/usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Connect with USB cable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Plug the tablet into the Mac with a USB cable and leave USB debugging on. Pane on the Mac has to be open. There is no Wi-Fi connection."
                android:textColor="#8E8A84"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tap to click. Drag to scroll. Press and hold, then drag, to move windows or select text. Tap with two fingers to right-click. Pinch to zoom. Go back to disconnect."
                android:textColor="#8E8A84"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
